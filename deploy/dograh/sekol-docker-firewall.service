[Unit]
Description=Allow the Dograh Docker network to reach the Sekol CRM
After=docker.service ufw.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -i br-5965e3a7f405 -s 172.18.0.0/16 -p tcp --dport 3000 -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I INPUT 1 -i br-5965e3a7f405 -s 172.18.0.0/16 -p tcp --dport 3000 -j ACCEPT'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
