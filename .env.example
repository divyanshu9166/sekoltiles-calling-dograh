DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_calling_agent"
CAMPAIGN_STALE_RUN_SEC="40"

BUSINESS_TYPE="tiles"
CRM_API_URL="http://localhost:3000"
# Public HTTPS origin reachable from the Dograh containers (no trailing slash).
CRM_PUBLIC_URL="https://crm.example.com"
CRM_API_SECRET="replace-with-a-long-random-secret"

# Self-hosted Dograh API. The helper accepts either the origin or /api/v1 URL.
DOGRAH_API_URL="https://voice.example.com"
DOGRAH_API_KEY=""
DOGRAH_WORKFLOW_UUID=""
DOGRAH_AGENT_NAME="Anushka"
DOGRAH_TELEPHONY_PROVIDER="vobiz"
# Set to the named Asterisk PJSIP trunk (for example, "vobiz") only after
# switching the Dograh configuration to Asterisk ARI.
DOGRAH_ARI_TRUNK_ENDPOINT=""
# E.164 human-team number; with ARI it is live-transferred through the named trunk.
CALL_TRANSFER_NUMBER="+919726418181"

# Optional: pin calls to a specific Dograh Vobiz configuration/caller ID.
DOGRAH_TELEPHONY_CONFIGURATION_ID=""
DOGRAH_FROM_PHONE_NUMBER_ID=""

# Copy the script URL from Dograh's headless Voice widget configuration.
NEXT_PUBLIC_DOGRAH_WIDGET_URL=""

# Dograh's existing model remains primary when no backup key is configured.
DOGRAH_GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"

# Put this value in Dograh's own .env on the VPS. When set, a primary Groq 429
# switches to this key while keeping the selected model and call context.
# Select openai/gpt-oss-120b in Dograh for the Sekol workflow.
DOGRAH_GROQ_BACKUP_API_KEY=""
# After primary Groq 429, new calls use the backup key for this many seconds.
DOGRAH_GROQ_429_COOLDOWN_SECONDS="60"

# ── WhatsApp Marketing (Meta WhatsApp Cloud API) ──────────────────────────
# 64 hex chars (32 bytes). Encrypts the stored WhatsApp access/verify tokens.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after saving a WhatsApp config, or the saved tokens/secrets can't be decrypted.
ENCRYPTION_KEY=""
# Meta App Dashboard → App settings → Basic → App secret. Verifies webhook
# signatures; without it every incoming webhook is rejected (401).
# Optional: can instead be saved in WhatsApp Marketing → Settings → Webhook
# Security, which takes priority over this value.
META_APP_SECRET=""
# Optional Graph API version for WhatsApp calls (default v21.0). Leave commented
# out unless needed: an empty value breaks every Meta API URL.
# WHATSAPP_GRAPH_API_VERSION="v21.0"
# Redis for automations, AI agent replies, the appointment chatbot and live inbox events.
REDIS_URL="redis://localhost:6379"
# Gemini key for the WhatsApp AI agent (GOOGLE_API_KEY is also accepted).
# Optional: can instead be saved in WhatsApp Marketing → AI Agent →
# Configuration, which takes priority over this value.
GEMINI_API_KEY=""
GEMINI_MODEL=""
# Folder for the downloaded knowledge-base embedding model (~120 MB, fetched on
# first use). Without it the model goes to /app/model-cache, which only exists
# in Docker images.
TRANSFORMERS_CACHE_DIR=".model-cache"
# Secret header (x-cron-secret) for GET /api/automations/cron, which resumes
# automation "wait" steps. Call it every minute from cron.
AUTOMATION_CRON_SECRET=""
# Optional live inbox updates via ws-server/ (socket.io). Leave
# NEXT_PUBLIC_WS_URL empty to fall back to polling. SESSION_SECRET signs the
# short-lived socket token and must match ws-server's SESSION_SECRET.
NEXT_PUBLIC_WS_URL=""
SESSION_SECRET=""
