DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_calling_agent"
CAMPAIGN_STALE_RUN_SEC="120"

BUSINESS_TYPE="tiles"
CRM_API_URL="http://localhost:3000"
# Public HTTPS origin reachable from the Dograh containers (no trailing slash).
CRM_PUBLIC_URL="https://crm.example.com"
CRM_API_SECRET="replace-with-a-long-random-secret"

# Self-hosted Dograh API. The helper accepts either the origin or /api/v1 URL.
DOGRAH_API_URL="https://voice.example.com"
DOGRAH_API_KEY=""
DOGRAH_WORKFLOW_UUID=""
DOGRAH_AGENT_NAME="Anushka"
DOGRAH_TELEPHONY_PROVIDER="vobiz"
# Set to the named Asterisk PJSIP trunk (for example, "vobiz") only after
# switching the Dograh configuration to Asterisk ARI.
DOGRAH_ARI_TRUNK_ENDPOINT=""
# E.164 human-team number; with ARI it is live-transferred through the named trunk.
CALL_TRANSFER_NUMBER="+919726418181"

# Optional: pin calls to a specific Dograh Vobiz configuration/caller ID.
DOGRAH_TELEPHONY_CONFIGURATION_ID=""
DOGRAH_FROM_PHONE_NUMBER_ID=""

# Copy the script URL from Dograh's headless Voice widget configuration.
NEXT_PUBLIC_DOGRAH_WIDGET_URL=""

# Dograh deployment override: the configured Groq model remains primary and
# switches to this model on a retryable Groq failure before any output is sent.
DOGRAH_GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
