DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_calling_agent"

BUSINESS_TYPE="tiles"
CRM_API_URL="http://localhost:3000"
CRM_API_SECRET="replace-with-a-long-random-secret"

# Self-hosted Dograh API. The helper accepts either the origin or /api/v1 URL.
DOGRAH_API_URL="https://voice.example.com"
DOGRAH_API_KEY=""
DOGRAH_WORKFLOW_UUID=""
DOGRAH_AGENT_NAME="Anushka"
DOGRAH_TELEPHONY_PROVIDER="vobiz"

# Optional: pin calls to a specific Dograh Vobiz configuration/caller ID.
DOGRAH_TELEPHONY_CONFIGURATION_ID=""
DOGRAH_FROM_PHONE_NUMBER_ID=""

# Copy the script URL from Dograh's headless Voice widget configuration.
NEXT_PUBLIC_DOGRAH_WIDGET_URL=""
