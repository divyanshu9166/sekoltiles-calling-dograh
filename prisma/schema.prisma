generator client {
  provider      = "prisma-client-js"
  runtime       = "nodejs"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String        @unique
  email        String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  callLogs     CallLog[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  contactId Int
  contact   Contact  @relation(fields: [contactId], references: [id])
  date      DateTime
  time      String
  purpose   String
  region    String?
  status    String   @default("Scheduled")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([date, time])
  @@index([contactId, status, date])
  @@index([date, status])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  IN_PROGRESS
  FAILED
  COMPLETED
  MISSED
  NO_ANSWER
  BUSY
}

model CallLog {
  id            Int            @id @default(autoincrement())
  contactId     Int?
  contact       Contact?       @relation(fields: [contactId], references: [id])
  customerName  String
  phone         String
  direction     CallDirection
  status        CallStatus
  duration      String?
  durationSec   Int            @default(0)
  agent         String         @default("AI Agent")
  date          DateTime
  time          String
  purpose       String?
  region        String?
  outcome       String?
  notes         String?
  recording     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  dograhRunId   String?        @unique
  recordingUrl  String?
  transcriptUrl String?
  callType      String?        @default("manual")
  aiHandled     Boolean        @default(false)
  transcript    CallTranscript?
  catalogueRequest CatalogueRequest?

  @@index([date])
  @@index([contactId])
}

model CatalogueRequest {
  id        Int      @id @default(autoincrement())
  callLogId Int      @unique
  callLog   CallLog  @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  customer  String
  phone     String
  region    String?
  requestedAt DateTime @default(now())

  @@index([requestedAt])
}

model CallTranscript {
  id        Int     @id @default(autoincrement())
  callLogId Int     @unique
  callLog   CallLog @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  summary   String?
  sentiment String?
  messages  Json
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  transferPhone String        @default("+919726418181")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

enum CampaignLeadStatus {
  PENDING
  CALLING
  COMPLETED
  FAILED
  SKIPPED
}

model MarketingCampaign {
  id                Int            @id @default(autoincrement())
  name              String
  instructions      String
  status            CampaignStatus @default(DRAFT)
  sourceType        String
  sourceName        String?
  interCallDelaySec Int            @default(15)
  nextCallAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  leads             CampaignLead[]

  @@index([status, createdAt])
}

model CampaignLead {
  id           Int                @id @default(autoincrement())
  campaignId   Int
  campaign     MarketingCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  region       String?
  status       CampaignLeadStatus @default(PENDING)
  attempts     Int                @default(0)
  callLogId    Int?
  dograhRunId  String?
  outcome      String?
  lastError    String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId, status, id])
  @@index([dograhRunId])
}
